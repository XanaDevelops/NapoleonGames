[resource]
script = ExtResource("231_2r177")
name = &"ForestMap"
desc = "Un antiguo paso montañoso que sirvió como ruta comercial principal antes de la Gran Guerra. Ahora, sus escarpados bordes y [color=#ffcc00]ruinas elevadas[/color] ofrecen posiciones tácticas inmejorables para las unidades a [b]distancia[/b]. Los densos bosques en los valles bajos [color=#ff6666]ralentizan el movimiento[/color] de la caballería y son el lugar perfecto para ocultar emboscadas enemigas. Domina los [color=#00ccff]puentes de piedra centrales[/color] para controlar el flujo de la batalla, pero ten mucho cuidado: los constantes [b]cuellos de botella[/b] castigarán duramente cualquier avance apresurado."
tamX = 23
tamY = 10
